# ID de mesure Google Analytics 4 (optionnel). Sans lui, aucun suivi.
NEXT_PUBLIC_GA_ID=
# Service de capture d'URL (optionnel, voir docs/CAPTURE.md), sans slash final.
# Sans lui, la capture depuis une URL est masquée.
NEXT_PUBLIC_CAPTURE_ENDPOINT=
# URL publique du site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
