# Origines autorisées, séparées par des virgules. « * » accepté dans le sous-domaine.
# Vide : toutes les origines (développement seulement).
ALLOWED_ORIGINS=http://localhost:3000
# Chrome installé, pour le développement sous Windows ou macOS
# (@sparticuz/chromium ne fonctionne que sous Linux).
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
